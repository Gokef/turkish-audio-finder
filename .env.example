# ---- Server ----
PORT=7000
# Public base URL (Render sets RENDER_EXTERNAL_URL automatically, so usually leave empty)
PUBLIC_URL=

# ---- Storage ----
# Recommended on Render free: Upstash Redis (free). If unset, results go to DATA_DIR/db.json.gz
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DATA_DIR=./data

# ---- Torrentio ----
TORRENTIO_URL=https://torrentio.strem.fun
# Optional public options, e.g. providers=yts,eztv,1337x,thepiratebay,torrentgalaxy
# Debrid keys are rejected on purpose - never put them here.
TORRENTIO_OPTIONS=
TORRENTIO_CONCURRENCY=2
TORRENTIO_MIN_INTERVAL_MS=1500
TORRENTIO_TIMEOUT_MS=20000

# ---- Scanner ----
SCANNER_ENABLED=true
SCAN_INTERVAL_HOURS=12
MAX_SCANS_PER_CYCLE=3000
RESCAN_POSITIVE_DAYS=14
RESCAN_NEGATIVE_DAYS=21
RESCAN_RECENT_NEGATIVE_DAYS=5
SERIES_PROBE_LATEST=true

# ---- Catalog size (titles crawled from Cinemeta per source) ----
MOVIE_TOP_DEPTH=4000
MOVIE_RATING_DEPTH=1000
MOVIE_YEAR_DEPTH=200
SERIES_TOP_DEPTH=1500
SERIES_RATING_DEPTH=500
SERIES_YEAR_DEPTH=100
YEAR_FROM=1990

# ---- Languages ----
LANGUAGES=tr
# Extra release groups known for Turkish dual-audio releases (comma separated)
TR_GROUPS=
